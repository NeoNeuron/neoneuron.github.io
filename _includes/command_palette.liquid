<!-- Command palette: the search panel that springs open from the navbar search button (assets/js/command-palette.js) -->
{% comment %}
  search-data.js (built from _scripts/search.liquid.js) hands its entries to a <ninja-keys> element.
  This empty one only carries them to the palette; the ninja-keys library itself is no longer loaded.
{% endcomment %}
<ninja-keys hidden></ninja-keys>
<div class="cmdk" id="cmdk" hidden>
  <div class="cmdk-chrome"></div>
  <div class="cmdk-box">
    <div class="cmdk-query">
      <i class="ti ti-search" aria-hidden="true"></i>
      <input
        id="cmdk-input"
        type="text"
        role="combobox"
        aria-expanded="false"
        aria-controls="cmdk-results"
        aria-autocomplete="list"
        aria-label="{{ site.data[site.active_lang].strings.command_palette.label }}"
        placeholder="{{ site.data[site.active_lang].strings.search.placeholder }}"
        autocomplete="off"
        spellcheck="false"
      >
    </div>
    <div class="cmdk-scroll">
      <ul class="cmdk-results" id="cmdk-results" role="listbox" aria-label="{{ site.data[site.active_lang].strings.command_palette.label }}">
        <li class="cmdk-highlight" role="presentation"></li>
      </ul>
      <p class="cmdk-empty" hidden>{{ site.data[site.active_lang].strings.command_palette.empty }}</p>
    </div>
  </div>
</div>
<script defer src="{{ '/assets/js/command-palette.js' | relative_url | bust_file_cache }}"></script>
<script
  src="{% if site.active_lang != site.default_lang %}{{ '/assets/js/search-data.js' | prepend: site.active_lang | relative_url }}{% else %}{{ '/assets/js/search-data.js' | relative_url }}{% endif %}"
></script>
<script src="{{ '/assets/js/shortcut-key.js' | relative_url | bust_file_cache }}"></script>
